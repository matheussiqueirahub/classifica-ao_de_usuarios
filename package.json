{
  "name": "classificacao-de-usuarios",
  "version": "2.0.0",
  "description": "Plataforma de classificacao de usuarios com frontend web e backend API seguro e escalavel.",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-server.mjs",
    "dev:api": "node --watch backend/src/server.js",
    "start:api": "node backend/src/server.js",
    "test:api": "node --test backend/tests/**/*.test.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0"
  },
  "keywords": [
    "classificacao",
    "usuarios",
    "acesso",
    "frontend",
    "backend",
    "api",
    "javascript"
